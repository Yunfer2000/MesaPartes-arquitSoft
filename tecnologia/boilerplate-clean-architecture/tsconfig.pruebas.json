{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-pruebas",
    "types": ["node"]
  },
  "include": [
    "src/app/dominio/**/*.ts",
    "src/app/aplicacion/**/*.ts",
    "src/app/infraestructura/**/*.ts",
    "src/app/pruebas/**/*.ts"
  ]
}