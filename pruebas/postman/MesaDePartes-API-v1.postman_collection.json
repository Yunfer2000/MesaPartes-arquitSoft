            "url": {
              "raw": "{{baseUrl}}/tipos-documento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tipos-documento"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Solicitud Postman {{$timestamp}}\",\n  \"descripcion\": \"Creado desde la colección de pruebas\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const esquemaTipo = { type: \"object\", required: [\"id\", \"nombre\", \"activo\"], properties: { id: { type: \"integer\" }, nombre: { type: \"string\" }, descripcion: { type: [\"string\", \"null\"] }, activo: { type: \"boolean\" } } };",
                  "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Trae la cabecera Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.test(\"Cumple el esquema TipoDocumento\", () => {",
                  "    const tipo = pm.response.json().data;",
                  "    pm.expect(tv4.validate(tipo, esquemaTipo)).to.be.true;",
                  "    pm.expect(tipo.activo).to.be.true;",
                  "    pm.collectionVariables.set(\"tipoId\", tipo.id);",
                  "});"
                ]
              }
            }
          ]
        },
