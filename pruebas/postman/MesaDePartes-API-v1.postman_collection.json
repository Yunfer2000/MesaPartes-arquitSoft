{
  "info": {
    "name": "Mesa de Partes Virtual · API REST v1",
    "description": "Pruebas funcionales y validación del contrato OpenAPI (Sprint 2). Antes de correrla: levanta el sistema con php artisan serve, crea los datos de prueba con php artisan migrate --seed y cambia numeroExpediente y dniRemitente por un trámite real.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Token de acceso",
      "item": [
        {
          "name": "Obtener token (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tokens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"contrasena\": \"{{adminContrasena}}\",\n  \"dispositivo\": \"postman\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devuelve un token Bearer\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.tipo).to.eql(\"Bearer\");",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"token\", json.token);",
                  "});",
                  "pm.test(\"Responde en menos de 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Credenciales incorrectas (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tokens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"contrasena\": \"incorrecta\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Trae mensaje\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Tipos de documento (CRUD)",
      "item": [
        {
          "name": "Consulta general (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tipos-documento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tipos-documento"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const esquemaTipo = { type: \"object\", required: [\"id\", \"nombre\", \"activo\"], properties: { id: { type: \"integer\" }, nombre: { type: \"string\" }, descripcion: { type: [\"string\", \"null\"] }, activo: { type: \"boolean\" } } };",
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estructura de la lista según el contrato\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    json.data.forEach(t => pm.expect(tv4.validate(t, esquemaTipo), tv4.error && tv4.error.message).to.be.true);",
                  "});",
                  "pm.test(\"Responde en menos de 3 s (RNF04)\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro válido (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
