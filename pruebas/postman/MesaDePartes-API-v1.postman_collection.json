              ],
              "path": [
                "consultas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"{{numeroExpediente}}\",\n  \"numero_documento\": \"{{dniRemitente}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 (cambia numeroExpediente y dniRemitente por uno real)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae estado y recorrido\", () => {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property(\"estado\");",
                  "    pm.expect(data.recorrido).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(data).to.not.have.property(\"correo\");",
                  "});",
                  "pm.test(\"Responde en menos de 3 s (EQ01)\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
