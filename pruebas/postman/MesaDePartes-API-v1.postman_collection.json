      "name": "3. Consultas y verificaciones",
      "item": [
        {
          "name": "Consultar expediente (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
